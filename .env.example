# ─────────────────────────────────────────────────────────────
# LLMPad — every token funds a model. Environment variables.
# Copy to .env.local and fill in. Never commit real keys.
# ─────────────────────────────────────────────────────────────

# --- OpenRouter (the "Any LLM" layer) ---
# The model CATALOG is public and needs no key — the /api/models route works
# out of the box. A key is only required to actually SPEND compute (the chat /
# playground) and to report live credit balance. Get one at
# https://openrouter.ai/keys and top up credits.
OPENROUTER_API_KEY=
# Optional: default model used when a launch doesn't pin one.
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
# Optional attribution headers OpenRouter shows on your account dashboard.
OPENROUTER_APP_URL=https://llmpad.local
OPENROUTER_APP_TITLE=LLMPad

# --- Treasury keeper (fees → OpenRouter credit accounting) ---
# /api/treasury/sync records how much compute each token's trading fees have
# funded. Set a secret to require it as the `x-treasury-secret` header (leave
# unset only for local dev — then the route is open).
TREASURY_SECRET=

# --- Compute pool storage (token → model, accrued credits) ---
# Vercel KV (Storage tab) sets KV_REST_API_URL / KV_REST_API_TOKEN.
# An Upstash Redis marketplace integration sets the UPSTASH_* pair instead.
# Without any of these the pool falls back to in-memory (resets on redeploy).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Wallet (Reown AppKit connect modal) ---
# Reown / WalletConnect Project ID (free at cloud.reown.com). REQUIRED for the
# full searchable 550+ wallet directory and mobile QR connect in the modal.
# Without it, only injected/browser wallets (MetaMask, Trust, etc.) that the
# user already has installed will show, and the wallet search will be empty.
NEXT_PUBLIC_WC_PROJECT_ID=

# --- Chain / explorer (public, safe to expose) — Robinhood Chain ---
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# --- Pons v2 contract addresses (verified defaults hardcoded in registry.ts) ---
# Override only if needed.
NEXT_PUBLIC_PONS_V2_FACTORY=
# Optional: extra ERC-20 quote assets for v2, comma-separated. Native ETH is
# always available and is the default pair for LLMPad launches.
NEXT_PUBLIC_V2_PAIR_TOKENS=
